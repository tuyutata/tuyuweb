{
  "name": "tuyuweb",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "25.2.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test": "npm run build && npm run test:contracts && npm run test:sites",
    "test:contracts": "node --test tests/app-contract.test.mjs",
    "test:release": "node --test tests/release-candidate.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans-sc": "5.3.0",
    "@fontsource/noto-serif-sc": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.0.1",
    "vite": "8.0.4"
  }
}
